AI_PLATFORM_SCHEMA_VERSION=2
AI_DOMAIN=ai.example.com
VLLM_IMAGE=vllm/vllm-openai:v0.30.0
DATABASE_URL=postgresql+psycopg://vllm_ai:replace-me@postgres:5432/vllm_ai
POSTGRES_DB=vllm_ai
POSTGRES_USER=vllm_ai
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@redis:6379/0
REDIS_PASSWORD=replace-me
APP_SECRET=replace-me
API_KEY_PEPPER=replace-me
INTERNAL_GATEWAY_TOKEN=replace-me
CONTROLLER_TOKEN=replace-me
PROXY_SHARED_TOKEN=replace-me
TRUSTED_PROXY_CIDRS=172.16.0.0/12
GLOBAL_ALLOWED_CIDRS=
ALLOWED_ORIGINS=https://ai.example.com
COOKIE_SECURE=true
ADMIN_PANEL_ENABLED=true
CHAT_PORTAL_ENABLED=true
PROMPT_LOGGING=false
AI_BACKUP_RETENTION_DAYS=14
AI_DISK_RESERVE_GB=20
AI_INTERNAL_NETWORK=vllm-ai-internal
AI_SHARED_NETWORK=laravel-shared
AI_PLATFORM_ROOT=/opt/vllm-ai-platform
AI_RUNTIME_MODE=docker
NATIVE_VLLM_VERSION=0.30.0
NATIVE_VLLM_EXECUTABLE=/opt/vllm-ai-platform/native/vllm-venv/bin/vllm
NATIVE_GATEWAY_PORT=8000
NATIVE_WEB_PORT=18080
NATIVE_CONTROLLER_PORT=8090
NATIVE_REDIS_PORT=16379
NATIVE_VLLM_PORT_START=19000
NATIVE_VLLM_PORT_END=19999
NATIVE_SERVICE_USER=vllmai
HF_TOKEN_FILE=/run/secrets/hf_token
EXTERNAL_EXPOSURE_MODE=none
CLOUDFLARED_EXECUTABLE=/opt/instance-tools/bin/cloudflared
CLOUDFLARED_TOKEN_FILE=/opt/vllm-ai-platform/secrets/cloudflare_tunnel_token
CLOUDFLARE_PANEL_HOSTNAME=
CLOUDFLARE_API_HOSTNAME=

